{
  "expo": {
    "name": "Booth Buddy",
    "slug": "market-day",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-app.png",
    "scheme": "marketday",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dinnagonzales.boothbuddy",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dinnagonzales.boothbuddy",
      "adaptiveIcon": {
        "backgroundColor": "#EDE9F5",
        "foregroundImage": "./assets/images/logo-app.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo-app.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-app.png",
          "resizeMode": "contain",
          "backgroundColor": "#EDE9F5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Booth Buddy uses your photo library so you can add pictures of items for staff and customers to see.",
          "cameraPermission": "Booth Buddy uses the camera so you can photograph items for staff and customers to see.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "6f82a4d7-8280-466b-8b4c-8cd10aad459a"
      }
    },
    "owner": "titadinna"
  }
}
